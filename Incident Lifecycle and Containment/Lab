Manually remove remaining artifacts:

# Remove any remaining malicious files
sudo find /tmp -name '*payload*' -delete

# Flush iptables rules (reset firewall)
sudo iptables -F
sudo iptables -X

# Kill any remaining suspicious processes
sudo pkill -f meterpreter
