Task 1: Deploy ELK Stack for Monitoring
Step 1.1: Install Elasticsearch
# Update system and install Java
sudo apt update && sudo apt upgrade -y
sudo apt install openjdk-11-jdk -y

# Add Elasticsearch repository
wget -qO - https://artifacts.elastic.co/GPG-KEY-elasticsearch | sudo apt-key add -
echo "deb https://artifacts.elastic.co/packages/7.x/apt stable main" | sudo tee /etc/apt/sources.list.d/elastic-7.x.list

# Install Elasticsearch
sudo apt update
sudo apt install elasticsearch -y
Configure Elasticsearch:

sudo nano /etc/elasticsearch/elasticsearch.yml
Add minimal configuration:

cluster.name: monitoring-cluster
node.name: node-1
network.host: localhost
http.port: 9200
discovery.type: single-node
xpack.security.enabled: false
Start Elasticsearch:

sudo systemctl start elasticsearch
sudo systemctl enable elasticsearch
sleep 30
curl -X GET "localhost:9200/"
Step 1.2: Install and Configure Logstash
# Install Logstash
sudo apt install logstash -y

# Create configuration directory
sudo mkdir -p /etc/logstash/conf.d
Create Logstash pipeline configuration:

sudo nano /etc/logstash/conf.d/monitoring.conf
Add configuration:

input {
  file {
    path => "/var/log/auth.log"
    start_position => "beginning"
    type => "auth"
    tags => ["security"]
  }
  
  file {
    path => "/var/log/syslog"
    start_position => "beginning"
    type => "syslog"
    tags => ["system"]
  }
}

filter {
  if [type] == "auth" {
    grok {
      match => { "message" => "%{SYSLOGTIMESTAMP:timestamp} %{IPORHOST:host} %{DATA:program}(?:\[%{POSINT:pid}\])?: %{GREEDYDATA:auth_message}" }
    }
    
    if [auth_message] =~ /Failed password/ {
      grok {
        match => { "auth_message" => "Failed password for %{USERNAME:failed_user} from %{IP:source_ip}" }
      }
      mutate {
        add_tag => ["failed_login"]
        add_field => { "alert_level" => "medium" }
        add_field => { "alert_type" => "auth_failure" }
      }
    }
  }
  
  if [type] == "syslog" {
    grok {
      match => { "message" => "%{SYSLOGTIMESTAMP:timestamp} %{IPORHOST:host} %{DATA:program}(?:\[%{POSINT:pid}\])?: %{GREEDYDATA:log_message}" }
    }
    
    if [log_message] =~ /ERROR/ {
      mutate {
        add_tag => ["error"]
        add_field => { "alert_level" => "high" }
        add_field => { "alert_type" => "system_error" }
      }
    }
  }
}

output {
  elasticsearch {
    hosts => ["localhost:9200"]
    index => "monitoring-logs-%{+YYYY.MM.dd}"
  }
}
Start Logstash:

sudo systemctl start logstash
sudo systemctl enable logstash
Step 1.3: Install Kibana
# Install Kibana
sudo apt install kibana -y

# Configure Kibana
sudo nano /etc/kibana/kibana.yml
Add configuration:

server.port: 5601
server.host: "localhost"
elasticsearch.hosts: ["http://localhost:9200"]
Start Kibana:

sudo systemctl start kibana
sudo systemctl enable kibana
sleep 60
curl -I http://localhost:5601
