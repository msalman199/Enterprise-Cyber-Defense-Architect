Task 1: Network Traffic Capture with Wireshark
Step 1: Install Required Tools
# Update and install Wireshark and network tools
sudo apt update
sudo apt install -y wireshark tcpdump net-tools

# Add user to wireshark group
sudo usermod -a -G wireshark $USER

# Verify installation
tshark --version
Step 2: Generate Sample Network Traffic
# Create traffic generation script
cat > generate_traffic.sh << 'EOF'
#!/bin/bash
echo "Generating network traffic..."
curl -s http://httpbin.org/get > /dev/null &
curl -s http://httpbin.org/post -d "test=data" > /dev/null &
nslookup google.com > /dev/null &
nslookup github.com > /dev/null &
curl -s https://www.example.com > /dev/null &
sleep 2
echo "Traffic generation completed."
EOF

chmod +x generate_traffic.sh
Step 3: Capture Network Traffic
# Start packet capture for 30 seconds
sudo tshark -i any -w /tmp/capture1.pcap -a duration:30 &

# Generate traffic during capture
sleep 5
./generate_traffic.sh

# Wait for capture to complete
wait
echo "Capture saved to /tmp/capture1.pcap"
Step 4: Analyze Captured Traffic
# Display capture statistics
capinfos /tmp/capture1.pcap

# Show first 10 packets
tshark -r /tmp/capture1.pcap -c 10

# Filter HTTP traffic
tshark -r /tmp/capture1.pcap -Y "http" -T fields -e frame.number -e ip.src -e ip.dst -e http.request.method

# Filter DNS traffic
tshark -r /tmp/capture1.pcap -Y "dns" -T fields -e frame.number -e dns.qry.name -e dns.resp.addr

# Protocol hierarchy statistics
tshark -r /tmp/capture1.pcap -q -z io,phs
