Task 3: Network Monitoring with Zeek
Step 1: Install Zeek
# Install dependencies
sudo apt install -y cmake make gcc g++ flex bison libpcap-dev libssl-dev python3-dev swig zlib1g-dev

# Download and install Zeek
cd /tmp
wget https://download.zeek.org/zeek-4.2.1.tar.gz
tar -xzf zeek-4.2.1.tar.gz
cd zeek-4.2.1
./configure --prefix=/opt/zeek
make -j$(nproc)
sudo make install

# Add to PATH
echo 'export PATH=/opt/zeek/bin:$PATH' >> ~/.bashrc
source ~/.bashrc
Step 2: Basic Zeek Configuration
# Create working directory
mkdir -p ~/zeek_analysis
cd ~/zeek_analysis

# Create basic configuration
cat > local.zeek << 'EOF'
@load base/protocols/conn
@load base/protocols/dns
@load base/protocols/http
@load base/protocols/ssl

# Enable JSON logging
redef LogAscii::use_json = T;
EOF
Step 3: Analyze Traffic with Zeek
# Run Zeek on captured traffic
/opt/zeek/bin/zeek -r /tmp/capture1.pcap local.zeek

# View generated logs
ls -la *.log

# Display connection log
cat conn.log | head -5

# Display DNS log
cat dns.log | head -5

# Display HTTP log
cat http.log | head -5
