Troubleshooting Tips
Issue 1: Terraform Authentication Errors
# Verify Azure CLI login
az account show

# Re-authenticate if needed
az login

# Set correct subscription
az account set --subscription "your-subscription-id"
Issue 2: Python Script Execution Errors
# Check Azure CLI is accessible
which az

# Verify Python version
python3 --version

# Install missing modules
pip3 install azure-cli-core
Issue 3: Lynis Permission Denied
# Run with sudo
sudo lynis audit system

# Check Lynis permissions
ls -la /usr/share/lynis/

# Reinstall if corrupted
sudo apt-get install --reinstall lynis
Issue 4: NSG Rules Not Applying
# Verify NSG association
az network vnet subnet show --resource-group rg-security-lab --vnet-name vnet-security-lab --name subnet-web

# Check NSG effective rules
az network nic list-effective-nsg --resource-group rg-security-lab --name your-nic-name

# Force Terraform refresh
terraform refresh
terraform apply
