Task 3: Configure Elastic Stack for Log Analysis
Step 3.1: Install Elastic Stack Components
# Install Java
sudo apt install -y openjdk-11-jdk

# Add Elastic repository
wget -qO - https://artifacts.elastic.co/GPG-KEY-elasticsearch | sudo apt-key add -
echo "deb https://artifacts.elastic.co/packages/8.x/apt stable main" | sudo tee /etc/apt/sources.list.d/elastic-8.x.list

# Install components
sudo apt update
sudo apt install -y elasticsearch kibana logstash
Step 3.2: Configure Elasticsearch
sudo tee /etc/elasticsearch/elasticsearch.yml > /dev/null << 'EOF'
cluster.name: ids-lab
node.name: ids-node
network.host: localhost
http.port: 9200
discovery.type: single-node
xpack.security.enabled: false
EOF

# Start Elasticsearch
sudo systemctl enable elasticsearch
sudo systemctl start elasticsearch

# Wait and verify
sleep 30
curl -X GET "localhost:9200/"
Step 3.3: Configure Kibana
sudo tee /etc/kibana/kibana.yml > /dev/null << 'EOF'
server.port: 5601
server.host: "localhost"
elasticsearch.hosts: ["http://localhost:9200"]
EOF

# Start Kibana
sudo systemctl enable kibana
sudo systemctl start kibana
Step 3.4: Configure Logstash for IDS Logs
sudo tee /etc/logstash/conf.d/ids.conf > /dev/null << 'EOF'
input {
  file {
    path => "/var/log/snort/alert.txt"
    start_position => "beginning"
    type => "snort"
  }
  file {
    path => "/var/log/suricata/eve.json"
    codec => "json"
    type => "suricata"
  }
}

filter {
  if [type] == "snort" {
    grok {
      match => { 
        "message" => "\[%{DATA:generator_id}:%{DATA:signature_id}:%{DATA:revision}\] %{DATA:alert_msg} \[Classification: %{DATA:classification}\] \[Priority: %{DATA:priority}\]"
      }
    }
  }
}

output {
  elasticsearch {
    hosts => ["localhost:9200"]
    index => "ids-alerts-%{+YYYY.MM.dd}"
  }
}
EOF

# Start Logstash
sudo systemctl enable logstash
sudo systemctl start logstash
