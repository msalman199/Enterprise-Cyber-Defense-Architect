Task 1: Create Virtual Network Segments
Step 1.1: Install Required Tools
# Update system and install tools
sudo apt update
sudo apt install -y nmap python3 python3-pip wireshark tshark net-tools iptables-persistent

# Verify installations
nmap --version
python3 --version
Step 1.2: Create Network Segments
Create three isolated network segments: DMZ, Internal, and Guest zones.

# Create virtual bridges for network segments
sudo ip link add name dmz-br type bridge
sudo ip link add name internal-br type bridge
sudo ip link add name guest-br type bridge

# Assign IP addresses to segments
sudo ip addr add 192.168.10.1/24 dev dmz-br
sudo ip addr add 192.168.20.1/24 dev internal-br
sudo ip addr add 192.168.30.1/24 dev guest-br

# Activate interfaces
sudo ip link set dmz-br up
sudo ip link set internal-br up
sudo ip link set guest-br up

# Create network namespaces for isolation
sudo ip netns add dmz-zone
sudo ip netns add internal-zone
sudo ip netns add guest-zone

# Create veth pairs for connectivity
sudo ip link add dmz-veth type veth peer name dmz-veth-br
sudo ip link add internal-veth type veth peer name internal-veth-br
sudo ip link add guest-veth type veth peer name guest-veth-br

# Move interfaces to namespaces
sudo ip link set dmz-veth netns dmz-zone
sudo ip link set internal-veth netns internal-zone
sudo ip link set guest-veth netns guest-zone

# Connect to bridges
sudo ip link set dmz-veth-br master dmz-br
sudo ip link set internal-veth-br master internal-br
sudo ip link set guest-veth-br master guest-br

# Configure namespace IPs
sudo ip netns exec dmz-zone ip addr add 192.168.10.10/24 dev dmz-veth
sudo ip netns exec internal-zone ip addr add 192.168.20.10/24 dev internal-veth
sudo ip netns exec guest-zone ip addr add 192.168.30.10/24 dev guest-veth

# Activate namespace interfaces
sudo ip netns exec dmz-zone ip link set dmz-veth up
sudo ip netns exec internal-zone ip link set internal-veth up
sudo ip netns exec guest-zone ip link set guest-veth up
sudo ip link set dmz-veth-br up
sudo ip link set internal-veth-br up
sudo ip link set guest-veth-br up

# Add default routes in namespaces
sudo ip netns exec dmz-zone ip route add default via 192.168.10.1
sudo ip netns exec internal-zone ip route add default via 192.168.20.1
sudo ip netns exec guest-zone ip route add default via 192.168.30.1
Step 1.3: Perform Network Discovery with Nmap
# Scan each network segment
echo "=== DMZ Network Scan ==="
nmap -sn 192.168.10.0/24

echo "=== Internal Network Scan ==="
nmap -sn 192.168.20.0/24

echo "=== Guest Network Scan ==="
nmap -sn 192.168.30.0/24

# Detailed service detection
nmap -sV -O 192.168.10.10 192.168.20.10 192.168.30.10

# Save network map
nmap -sn 192.168.10.0/24 192.168.20.0/24 192.168.30.0/24 -oN network_map.txt
Step 1.4: Test Initial Connectivity
# Test cross-segment connectivity (should work before rules applied)
echo "Testing DMZ to Internal:"
sudo ip netns exec dmz-zone ping -c 2 192.168.20.10

echo "Testing Guest to Internal:"
sudo ip netns exec guest-zone ping -c 2 192.168.20.10

echo "Testing Guest to DMZ:"
sudo ip netns exec guest-zone ping -c 2 192.168.10.10
