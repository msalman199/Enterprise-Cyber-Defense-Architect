Task 3: Analyze Traffic with Wireshark
Step 3.1: Start Network Services
# Start HTTP servers in each segment
sudo ip netns exec dmz-zone python3 -m http.server 80 &
sudo ip netns exec internal-zone python3 -m http.server 8080 &
sudo ip netns exec guest-zone python3 -m http.server 8090 &

# Save process IDs for cleanup
echo $! > service_pids.txt
Step 3.2: Capture Network Traffic
# Create capture directory
mkdir -p captures && cd captures

# Start packet capture on DMZ bridge (60 seconds)
sudo tshark -i dmz-br -w dmz_traffic.pcap -a duration:60 &

# Start capture on Internal bridge
sudo tshark -i internal-br -w internal_traffic.pcap -a duration:60 &

# Start capture on Guest bridge
sudo tshark -i guest-br -w guest_traffic.pcap -a duration:60 &
Step 3.3: Generate Test Traffic
# Test allowed traffic: Guest to DMZ HTTP
sudo ip netns exec guest-zone curl -m 5 http://192.168.10.10/

# Test blocked traffic: Guest to Internal
sudo ip netns exec guest-zone curl -m 5 http://192.168.20.10:8080/

# Test allowed traffic: Internal to DMZ
sudo ip netns exec internal-zone curl -m 5 http://192.168.10.10/

# Generate multiple connection attempts
for i in {1..5}; do
    sudo ip netns exec guest-zone ping -c 1 192.168.20.10
    sleep 1
done

# Wait for captures to complete
wait
Step 3.4: Analyze Captured Traffic
# Analyze DMZ traffic
echo "=== DMZ Traffic Analysis ==="
tshark -r dmz_traffic.pcap -q -z conv,ip

# Analyze blocked attempts
echo "=== Blocked Connection Attempts ==="
tshark -r guest_traffic.pcap -Y "tcp.flags.syn==1 && tcp.flags.ack==0"

# Count packets by protocol
echo "=== Protocol Distribution ==="
tshark -r dmz_traffic.pcap -q -z io,phs

# Display HTTP requests
echo "=== HTTP Requests ==="
tshark -r dmz_traffic.pcap -Y "http.request" -T fields -e ip.src -e http.request.uri

# Open in Wireshark GUI for detailed analysis
wireshark dmz_traffic.pcap &
